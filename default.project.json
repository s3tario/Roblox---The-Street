{
  "name": "TheStreet",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "WorldBuilders": {
        "$path": "src/world"
      },
      "FirmTemplates": {
        "$path": "build/Templates.rbxm"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CameraMaxZoomDistance": 60,
        "CharacterWalkSpeed": 18
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "SignalBehavior": "Deferred"
      },
      "World": {
        "$path": "build/World.rbxm"
      },
      "Handmade": {
        "$path": {
          "optional": "src/handmade"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Brightness": 2.4,
        "ClockTime": 14.5,
        "GeographicLatitude": 40.7,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.8,
        "GlobalShadows": true,
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.52
        ]
      }
    },
    "Players": {
      "$properties": {
        "MaxPlayers": 24
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}