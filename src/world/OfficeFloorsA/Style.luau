--!strict
-- Floor styles: the colours and materials one department floor is dressed in. Every floor template shares the same
-- plan (Layout) and the same slot/marker builders (Desks, Offices, Rooms); a style decides how they look. "ib" is
-- the owner's reference photo (white pods with terrazzo ends, orange-seat mesh chairs, grey-blue carpet, concrete
-- and brass); "plain" is the clean placeholder used by floors that later milestones replace. Bake-safe.

local Deps = require(script.Parent.Deps)

local hex = Deps.Palette.hex
local M = Enum.Material

export type Style = {
	id: string,
