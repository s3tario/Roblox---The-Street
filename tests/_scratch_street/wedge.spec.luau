local Kit = require(game:GetService("ReplicatedStorage").Shared.Build.Kit)
return function(t)
	t.it("wedge", function()
		local a = Kit.block(nil, CFrame.new(1, 2, 3), Vector3.one)
		print("kit block", pcall(function() return a.Position end))
		local w = Kit.wedge(nil, CFrame.new(1, 2, 3), Vector3.one)
		print("kit wedge", pcall(function() return w.Position end))
		local c = Kit.cylinder(nil, CFrame.new(1, 2, 3), 2, 2)
		print("kit cyl", pcall(function() return c.Position end))
		local p = Instance.new("Part")
		p.CFrame = CFrame.new(1, 2, 3)
		print("raw", pcall(function() return p.Position end))
		local q = Instance.new("Part")
		q.Size = Vector3.one
		q.CFrame = CFrame.new(1, 2, 3)
		print("raw sized", pcall(function() return q.Position end))
		local r = Instance.new("Part")
		r.Anchored = true
		r.CFrame = CFrame.new(1, 2, 3)
		print("raw anchored", pcall(function() return r.Position end))
	end)
end
