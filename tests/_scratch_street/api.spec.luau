return function(t)
	t.it("cframe api", function()
		local cf = CFrame.lookAt(Vector3.new(0, 0, 0), Vector3.new(0, 0, 10))
		print(cf.LookVector, cf.RightVector, cf:PointToObjectSpace(Vector3.new(1, 2, 3)))
		print(CFrame.fromMatrix(Vector3.zero, Vector3.new(1,0,0), Vector3.new(0,1,0)))
		local p = Instance.new("Part")
		p.Size = Vector3.new(2, 2, 2)
		local sg = Instance.new("SurfaceGui")
		sg.Parent = p
		p:AddTag("X")
		print(p:HasTag("X"), #p:GetTags())
		local s = Instance.new("SpawnLocation")
		print(s:IsA("BasePart"), s.ClassName)
		local w = Instance.new("WedgePart")
		print(w:IsA("BasePart"))
		local u = Instance.new("UIGradient")
		print(u ~= nil)
	end)
end
