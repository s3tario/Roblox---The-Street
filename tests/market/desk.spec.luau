-- The trading desk: order parsing, open-only trading, client transaction id idempotency, the "Max" fit, stops and
-- take-profits, the warning -> violation -> major risk ladder with desk trims, and flattening on leave / after a crash.
local Shared = game:GetService("ReplicatedStorage").Shared
local Ledger = require(Shared.Logic.Portfolio.Ledger)
local Desk = require(Shared.Logic.Portfolio.Desk)
local Risk = require(Shared.Logic.Portfolio.Risk)
local Txn = require(Shared.Logic.Portfolio.Txn)

local JUNIOR = Ledger.limits({ rank = 1 })
local SENIOR = Ledger.limits({ rank = 2 })

local function book(cash: number)
	return Ledger.new(cash, false)
end

return function(t)
	t.describe("orders", function()
		t.it("parses and validates order shapes", function()
			t.expect((Desk.parseOrder({ ticker = "APX", side = "buy", qty = 10 }))).never(nil)
			t.expect(select(2, Desk.parseOrder({ ticker = "ZZZ", side = "buy", qty = 1 }))).toBe("bad_ticker")
			t.expect(select(2, Desk.parseOrder({ ticker = "APX", side = "buy", qty = 0 }))).toBe("bad_qty")
			t.expect(select(2, Desk.parseOrder({ ticker = "APX", side = "buy", qty = 2.5 }))).toBe("bad_qty")
			t.expect(select(2, Desk.parseOrder({ ticker = "APX", side = "hold", qty = 1 }))).toBe("generic")
			t.expect(select(2, Desk.parseOrder({ ticker = "APX", side = "buy", qty = 1, stop = -3 }))).toBe("bad_stop")
			local close = Desk.parseOrder({ ticker = "APX", side = "close" }) :: any
			t.expect(close.qty).toBeNil()
			t.expect(select(2, Desk.parseOrder("buy"))).toBe("generic")
		end)
		t.it("only trades while the market is open", function()
			local b = book(10000)
			local r = Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "buy", qty = 1 }, JUNIOR, 1, false)
			t.expect(r.ok).toBe(false)
			t.expect(r.err).toBe("closed")
			t.expect(next(b.positions)).toBeNil()
		end)
		t.it("fills each client transaction id exactly once", function()
			local b = book(10000)
			local cache = Txn.new(4)
			local order = { ticker = "APX", side = "buy", qty = 10 }
			local prices = { APX = 100 }
			local r1, replay1 = Desk.submit(cache, "txn-1", b, prices, order, JUNIOR, 1, true)
			local r2, replay2 = Desk.submit(cache, "txn-1", b, prices, order, JUNIOR, 2, true)
			t.expect(r1.ok).toBe(true)
			t.expect(replay1).toBe(false)
			t.expect(replay2).toBe(true)
			t.expect(r2).toBe(r1)
			t.expect(b.positions.APX.shares).toBe(10)
			Desk.submit(cache, "txn-2", b, prices, order, JUNIOR, 3, true)
			t.expect(b.positions.APX.shares).toBe(20)
			-- a refused order replays its refusal too, even if it would pass now
			local refused = Desk.submit(cache, "txn-3", b, prices, { ticker = "APX", side = "buy", qty = 1 }, JUNIOR, 4, false)
			t.expect(refused.err).toBe("closed")
			local still = Desk.submit(cache, "txn-3", b, prices, { ticker = "APX", side = "buy", qty = 1 }, JUNIOR, 5, true)
			t.expect(still.err).toBe("closed")
			t.expect(b.positions.APX.shares).toBe(20)
			-- the cache is bounded
			for i = 4, 10 do
				Txn.put(cache, "x" .. i, true)
			end
			t.expect(Txn.size(cache)).toBe(4)
			t.expect(Txn.get(cache, "txn-1")).toBeNil()
		end)
		t.it("fits a Max order to the limits and closes positions", function()
			local b = book(10000)
			local prices = { APX = 100 }
			local r = Desk.trade(b, prices, { ticker = "APX", side = "buy", qty = 1000000, fit = true }, JUNIOR, 1, true)
			t.expect(r.ok).toBe(true)
			t.expect(b.positions.APX.shares).toBeBetween(39, 40)
			local close = Desk.trade(b, prices, { ticker = "APX", side = "close" }, JUNIOR, 2, true)
			t.expect(close.ok).toBe(true)
			t.expect(b.positions.APX).toBeNil()
			local none = Desk.trade(b, prices, { ticker = "APX", side = "close" }, JUNIOR, 3, true)
			t.expect(none.err).toBe("no_position")
			local tooBig = Desk.trade(b, prices, { ticker = "APX", side = "buy", qty = 50 }, JUNIOR, 4, true)
			t.expect(tooBig.err).toBe("concentration")
			local vars = Desk.errorVars(tooBig, JUNIOR)
			t.expect(vars.ticker).toBe("APX")
			t.expect(vars.limit).toBe("40%")
		end)
	end)

	t.describe("stops and take-profits", function()
		t.it("validates levels on the right side of the price", function()
			local b = book(10000)
			local prices = { APX = 100 }
			local bad = Desk.trade(b, prices, { ticker = "APX", side = "buy", qty = 5, stop = 105 }, JUNIOR, 1, true)
			t.expect(bad.err).toBe("bad_stop")
			t.expect(next(b.positions)).toBeNil()
			local badTake = Desk.trade(b, prices, { ticker = "APX", side = "buy", qty = 5, take = 95 }, JUNIOR, 1, true)
			t.expect(badTake.err).toBe("bad_take")
			local ok = Desk.trade(b, prices, { ticker = "APX", side = "buy", qty = 5, stop = 90, take = 120 }, JUNIOR, 1, true)
			t.expect(ok.ok).toBe(true)
			t.expect(b.stops.APX.stop).toBe(90)
			t.expect((Desk.setStops(b, prices, "APX", 95, nil))).toBe(true)
			t.expect(b.stops.APX.take).toBeNil()
			t.expect(select(2, Desk.setStops(b, prices, "NMB", 1, nil))).toBe("no_position")
			t.expect((Desk.setStops(b, prices, "APX", nil, nil))).toBe(true)
			t.expect(b.stops.APX).toBeNil()
		end)
		t.it("closes a long at its stop and a short at its take-profit", function()
			local b = book(20000)
			local risk = Risk.new()
			Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "buy", qty = 10, stop = 95 }, SENIOR, 1, true)
			Desk.trade(b, { NMB = 50 }, { ticker = "NMB", side = "sell", qty = 20, take = 45 }, SENIOR, 1, true)
			local quiet = Desk.process(b, risk, { APX = 99, NMB = 49 }, SENIOR, 2, true)
			t.expect(#quiet.fills).toBe(0)
			local hit = Desk.process(b, risk, { APX = 94, NMB = 44 }, SENIOR, 3, true)
			t.expect(#hit.fills).toBe(2)
			t.expect(hit.fills[1].reason).toBe("stop")
			t.expect(hit.fills[2].reason).toBe("take")
			t.expect(next(b.positions)).toBeNil()
			t.expect(next(b.stops)).toBeNil()
		end)
		t.it("doesn't trigger stops while the market is closed", function()
			local b = book(20000)
			Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "buy", qty = 10, stop = 95 }, JUNIOR, 1, true)
			local tick = Desk.process(b, Risk.new(), { APX = 90 }, JUNIOR, 2, false)
			t.expect(#tick.fills).toBe(0)
			t.expect(b.positions.APX.shares).toBe(10)
		end)
	end)

	t.describe("risk ladder", function()
		t.it("warns, then logs a violation and trims, and flags the third violation as major", function()
			local b = book(10000)
			local risk = Risk.new()
			Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "buy", qty = 39 }, JUNIOR, 0, true)
			local up = { APX = 140 } -- a winner grows past 40% of the book
			local first = Desk.process(b, risk, up, JUNIOR, 10, true)
			t.expect(#first.warn).toBe(1)
			t.expect(first.warn[1].kind).toBe("concentration")
			t.expect(first.warn[1].deadline).toBe(10 + Risk.GRACE)
			local early = Desk.process(b, risk, up, JUNIOR, 10 + Risk.GRACE - 1, true)
			t.expect(#early.violate).toBe(0)
			local due = Desk.process(b, risk, up, JUNIOR, 10 + Risk.GRACE, true)
			t.expect(#due.violate).toBe(1)
			t.expect(#due.fills).toBe(1)
			t.expect(due.fills[1].reason).toBe("trim")
			t.expect(due.major).toBe(false)
			t.expect(risk.weekViolations).toBe(1)
			t.expect(b.violations).toBe(1)
			local weight = math.abs(b.positions.APX.shares * 140) / Ledger.equity(b, up)
			t.expect(weight).toBeLessThan(JUNIOR.concentration)
			t.expect(risk.active["conc:APX"]).toBeNil() -- the trim cleared it
			local after = Desk.process(b, risk, up, JUNIOR, 10 + Risk.GRACE + 2, true)
			t.expect(#after.warn + #after.violate).toBe(0)
			-- two more breaches in the same week
			local now = 200
			for i = 2, 3 do
				local price = 140 * (1.3 ^ (i - 1))
				local p = { APX = price }
				Desk.process(b, risk, p, JUNIOR, now, true)
				local v = Desk.process(b, risk, p, JUNIOR, now + Risk.GRACE, true)
				t.expect(#v.violate).toBe(1)
				t.expect(v.major).toBe(i == 3)
				now += 200
			end
			t.expect(Risk.isMajor(risk)).toBe(true)
			Risk.resetWeek(risk)
			t.expect(risk.weekViolations).toBe(0)
			t.expect(risk.total).toBe(3)
		end)
		t.it("pauses deadlines while the market is closed and grants grace after a limit cut", function()
			local b = book(10000)
			local risk = Risk.new()
			Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "buy", qty = 39 }, JUNIOR, 0, true)
			local up = { APX = 140 }
			Desk.process(b, risk, up, JUNIOR, 10, true)
			Desk.process(b, risk, up, JUNIOR, 40, false) -- after hours for 30 s
			Desk.process(b, risk, up, JUNIOR, 70, false)
			local v = Desk.process(b, risk, up, JUNIOR, 75, true)
			t.expect(#v.violate).toBe(0)
			t.expect(risk.active["conc:APX"].deadline).toBe(10 + Risk.GRACE + 60)
			local cut = Ledger.limits({ rank = 1, mult = 0.6 })
			local fresh = Risk.new()
			local b2 = book(10000)
			Desk.trade(b2, { NMB = 50 }, { ticker = "NMB", side = "buy", qty = 70 }, JUNIOR, 0, true)
			Risk.grace(fresh, 100, Risk.LIMIT_CUT_GRACE)
			local warn = Desk.process(b2, fresh, { NMB = 50 }, cut, 101, true)
			t.expect(#warn.warn).toBe(1)
			t.expect(warn.warn[1].deadline).toBe(100 + Risk.LIMIT_CUT_GRACE)
		end)
		t.it("covers shorts the player may no longer hold and flattens a blown-up book", function()
			local b = book(10000)
			local risk = Risk.new()
			Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "sell", qty = 30 }, SENIOR, 0, true)
			-- fired back to a junior rank: the short is now a breach
			Desk.process(b, risk, { APX = 100 }, JUNIOR, 1, true)
			local v = Desk.process(b, risk, { APX = 100 }, JUNIOR, 1 + Risk.GRACE, true)
			t.expect(#v.violate).toBeGreaterThanOrEqual(1)
			t.expect(b.positions.APX).toBeNil()
			local blown = book(1000)
			Desk.trade(blown, { VLT = 10 }, { ticker = "VLT", side = "sell", qty = 140 }, SENIOR, 0, true)
			local r = Risk.new()
			local crash = { VLT = 20 } -- the short doubled: equity below zero
			Desk.process(blown, r, crash, SENIOR, 1, true)
			Desk.process(blown, r, crash, SENIOR, 1 + Risk.GRACE, true)
			t.expect(next(blown.positions)).toBeNil()
		end)
	end)

	t.describe("session books", function()
		t.it("ends the session flat at mid: equity and P/L persist, positions don't", function()
			local b = book(10000)
			Desk.trade(b, { APX = 100, NMB = 50 }, { ticker = "APX", side = "buy", qty = 20 }, JUNIOR, 0, true)
			Desk.trade(b, { APX = 100, NMB = 50 }, { ticker = "NMB", side = "buy", qty = 40 }, JUNIOR, 0, true)
			local prices = { APX = 110, NMB = 45 }
			local before = Ledger.equity(b, prices)
			local trades = Desk.leave(b, prices, 5)
			t.expect(#trades).toBe(2)
			t.expect(trades[1].kind).toBe("leave")
			t.expect(next(b.positions)).toBeNil()
			t.expect(b.cash).toBeCloseTo(before, 1e-6)
			t.expect(b.tradeCount).toBe(2)
		end)
		t.it("closes a book a crashed server left open at cost", function()
			local b = book(10000)
			Desk.trade(b, { APX = 100 }, { ticker = "APX", side = "buy", qty = 20 }, JUNIOR, 0, true)
			local cash = b.cash
			local trades = Desk.restore(b, 9)
			t.expect(#trades).toBe(1)
			t.expect(trades[1].kind).toBe("restore")
			t.expect(b.cash).toBeCloseTo(cash + 20 * 100.025, 1e-6)
			t.expect(trades[1].pnl).toBe(0)
		end)
	end)
end
