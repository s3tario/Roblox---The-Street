-- Trading book ledger: fills and the spread, average cost and realized P/L (longs, shorts, flips), limits by rank with
-- the risk multiplier and Risk Sense headroom, shorting and gross exposure, flows (top-ups, wipeout, paid capital),
-- flattening, rebirth and data repair.
local Shared = game:GetService("ReplicatedStorage").Shared
local Ledger = require(Shared.Logic.Portfolio.Ledger)

local P = { APX = 100, NMB = 50, MRB = 80, VLT = 90, SMT = 60 }

local function book(cash: number)
	local b = Ledger.new(cash, false)
	return b
end

return function(t)
	t.describe("fills", function()
		t.it("buys at the ask and tracks cost, cash and equity", function()
			local b = book(10000)
			local trade = Ledger.fill(b, "APX", 10, 100, 1, "trade")
			t.expect(trade.px).toBeCloseTo(100.025, 1e-6)
			t.expect(trade.fee).toBeCloseTo(0.25, 1e-6)
			t.expect(b.cash).toBeCloseTo(10000 - 1000.25, 1e-6)
			t.expect(b.positions.APX.shares).toBe(10)
			t.expect(b.positions.APX.avgCost).toBeCloseTo(100.025, 1e-9)
			t.expect(Ledger.equity(b, P)).toBeCloseTo(9999.75, 1e-6)
			t.expect(Ledger.invested(b, P)).toBe(1000)
			t.expect(b.tradeCount).toBe(1)
		end)
		t.it("realizes P/L on sells at the bid and closes the position", function()
			local b = book(10000)
			Ledger.fill(b, "APX", 10, 100, 1, "trade")
			local sell = Ledger.fill(b, "APX", -5, 110, 2, "trade")
			t.expect(sell.pnl).toBeCloseTo(5 * (110 * 0.99975 - 100.025), 1e-2)
			t.expect(b.positions.APX.shares).toBe(5)
			t.expect(b.positions.APX.avgCost).toBeCloseTo(100.025, 1e-9)
			b.stops.APX = { stop = 90 }
			Ledger.fill(b, "APX", -5, 110, 3, "trade")
			t.expect(b.positions.APX).toBeNil()
			t.expect(b.stops.APX).toBeNil()
			t.expect(b.realized).toBeCloseTo(10 * (110 * 0.99975 - 100.025), 1e-2)
		end)
		t.it("handles shorts and flips through zero", function()
			local b = book(10000)
			Ledger.fill(b, "APX", -10, 100, 1, "trade")
			t.expect(b.positions.APX.shares).toBe(-10)
			t.expect(b.cash).toBeCloseTo(10000 + 999.75, 1e-6)
			local cover = Ledger.fill(b, "APX", 10, 90, 2, "trade")
			t.expect(cover.pnl).toBeCloseTo(10 * (99.975 - 90.0225), 0.006)
			t.expect(b.realized).toBeCloseTo(10 * (99.975 - 90.0225), 1e-6)
			Ledger.fill(b, "NMB", 10, 50, 3, "trade")
			Ledger.fill(b, "NMB", -15, 52, 4, "trade")
			t.expect(b.positions.NMB.shares).toBe(-5)
			t.expect(b.positions.NMB.avgCost).toBeCloseTo(52 * 0.99975, 1e-9)
		end)
		t.it("flattens at mid without changing equity or counting trades", function()
			local b = book(10000)
			Ledger.fill(b, "APX", 20, 100, 1, "trade")
			Ledger.fill(b, "NMB", -30, 50, 1, "trade")
			local before = Ledger.equity(b, P)
			local count = b.tradeCount
			local trades = Ledger.flatten(b, P, 2, "leave")
			t.expect(#trades).toBe(2)
			t.expect(next(b.positions)).toBeNil()
			t.expect(Ledger.equity(b, P)).toBeCloseTo(before, 1e-6)
			t.expect(b.tradeCount).toBe(count)
		end)
	end)

	t.describe("limits", function()
		t.it("scales by rank, the probation multiplier and Risk Sense headroom", function()
			local junior = Ledger.limits({ rank = 1 })
			t.expect(junior.concentration).toBeCloseTo(0.4)
			t.expect(junior.gross).toBeCloseTo(1)
			t.expect(junior.short).toBe(false)
			local student = Ledger.limits({ rank = 0 })
			t.expect(student.concentration).toBeCloseTo(0.4)
			local senior = Ledger.limits({ rank = 2 })
			t.expect(senior.concentration).toBeCloseTo(0.5)
			t.expect(senior.gross).toBeCloseTo(1.5)
			t.expect(senior.short).toBe(true)
			t.expect(senior.margin).toBe(true)
			local probation = Ledger.limits({ rank = 1, mult = 0.6, headroom = 0.03 })
			t.expect(probation.concentration).toBeCloseTo(0.27)
			t.expect(probation.gross).toBeCloseTo(0.6)
		end)
		t.it("refuses a single name above the concentration limit", function()
			local b = book(10000)
			local limits = Ledger.limits({ rank = 1 })
			t.expect((Ledger.check(b, P, "APX", 39, limits))).toBe(true)
			local ok, err, p = Ledger.check(b, P, "APX", 41, limits)
			t.expect(ok).toBe(false)
			t.expect(err).toBe("concentration")
			t.expect((p :: any).weight).toBeGreaterThan(0.4)
			local most = Ledger.maxDelta(b, P, "APX", 1, limits)
			t.expect((Ledger.check(b, P, "APX", most, limits))).toBe(true)
			t.expect((Ledger.check(b, P, "APX", most + 1, limits))).toBe(false)
			t.expect(most).toBeBetween(39, 40)
		end)
		t.it("only lets associates and up short, within 150% gross", function()
			local b = book(10000)
			local junior = Ledger.limits({ rank = 1 })
			local _, err = Ledger.check(b, P, "APX", -5, junior)
			t.expect(err).toBe("no_short")
			local senior = Ledger.limits({ rank = 2 })
			t.expect((Ledger.check(b, P, "APX", -45, senior))).toBe(true)
			Ledger.fill(b, "APX", -45, 100, 1, "trade")
			Ledger.fill(b, "NMB", 90, 50, 1, "trade")
			Ledger.fill(b, "MRB", 56, 80, 1, "trade")
			local _, grossErr = Ledger.check(b, P, "VLT", 50, senior)
			t.expect(grossErr).toBe("gross")
		end)
		t.it("keeps juniors unleveraged and always allows reducing a breached position", function()
			local b = book(10000)
			local limits = Ledger.limits({ rank = 1 })
			Ledger.fill(b, "APX", 39, 100, 1, "trade")
			Ledger.fill(b, "NMB", 78, 50, 1, "trade")
			local _, err = Ledger.check(b, P, "MRB", 40, limits)
			t.expect(err).toBe("gross")
			local tight = Ledger.limits({ rank = 1, mult = 0.5 })
			t.expect((Ledger.check(b, P, "APX", -5, tight))).toBe(true)
			t.expect((Ledger.check(b, P, "APX", 1, tight))).toBe(false)
		end)
		t.it("rejects bad quantities and unknown tickers", function()
			local b = book(10000)
			local limits = Ledger.limits({ rank = 1 })
			t.expect(select(2, Ledger.check(b, P, "APX", 1.5, limits))).toBe("bad_qty")
			t.expect(select(2, Ledger.check(b, P, "APX", 0, limits))).toBe("bad_qty")
			t.expect(select(2, Ledger.check(b, P, "ZZZ", 1, limits))).toBe("bad_ticker")
			t.expect(select(2, Ledger.check(b, {}, "APX", 1, limits))).toBe("no_price")
		end)
	end)

	t.describe("flows", function()
		t.it("closes the paper account on hire and tops up on promotion keeping P/L", function()
			local b = Ledger.new(5000, true)
			Ledger.fill(b, "APX", 10, 100, 1, "trade")
			local flow = Ledger.setBookSize(b, 250000, "hired", { APX = 120 }, 2)
			t.expect(b.paper).toBe(false)
			t.expect(next(b.positions)).toBeNil()
			t.expect(b.cash).toBe(250000)
			t.expect(b.bookSize).toBe(250000)
			t.expect(flow).toBeGreaterThan(240000)
			t.expect(b.peak).toBe(250000)
			b.cash += 10000 -- a profitable week
			Ledger.setBookSize(b, 500000, "promotion", P, 3)
			t.expect(b.cash).toBe(510000)
			t.expect(b.bookSize).toBe(500000)
			t.expect(b.flows).toBeCloseTo(flow + 250000, 1e-6)
		end)
		t.it("never pushes equity below zero when a book shrinks", function()
			local b = book(100000)
			b.cash = 20000 -- heavy losses
			Ledger.setBookSize(b, 10000, "reentry", P, 1)
			t.expect(b.cash).toBe(0)
		end)
		t.it("wipes to 10% (minimum $5,000) and restores half the loss as paid capital", function()
			local b = book(500000)
			Ledger.fill(b, "APX", 100, 100, 1, "trade")
			local lost, newBook = Ledger.wipe(b, P, 2)
			t.expect(newBook).toBe(50000)
			t.expect(b.cash).toBe(50000)
			t.expect(next(b.positions)).toBeNil()
			t.expect(lost).toBeCloseTo(500000 - 2.5 - 50000, 1e-6)
			t.expect(b.lastWipe.restored).toBe(false)
			local amount, err = Ledger.restoreCapital(b, nil, 3)
			t.expect(amount).toBeNil()
			t.expect(err).toBe("no_credit")
			b.credits.capital = 2
			amount = Ledger.restoreCapital(b, nil, 3)
			t.expect(amount).toBe(math.floor(lost * 0.5))
			t.expect(b.paidCapital).toBe(amount)
			t.expect(b.cash).toBe(50000 + (amount :: number))
			t.expect(b.credits.capital).toBe(1)
			local again, err2 = Ledger.restoreCapital(b, nil, 4)
			t.expect(again).toBeNil()
			t.expect(err2).toBe("used")
			local small = book(20000)
			local _, floorBook = Ledger.wipe(small, P, 1)
			t.expect(floorBook).toBe(5000)
			small.credits.capital = 1
			t.expect(Ledger.restoreCapital(small, 900000, 2)).toBe(Ledger.CAPITAL_CAP)
		end)
		t.it("resets to the student paper account on rebirth, keeping paid credits and week records", function()
			local b = book(500000)
			b.credits.capital = 1
			table.insert(b.weekReturns, { s = 1, w = 3, twr = 0.01 })
			Ledger.fill(b, "APX", 10, 100, 1, "trade")
			Ledger.resetForRebirth(b, P, 2)
			t.expect(b.cash).toBe(Ledger.STUDENT_BOOK)
			t.expect(b.paper).toBe(true)
			t.expect(next(b.positions)).toBeNil()
			t.expect(b.credits.capital).toBe(1)
			t.expect(#b.weekReturns).toBe(1)
		end)
	end)

	t.describe("data repair", function()
		t.it("drops malformed positions and fills missing fields", function()
			local b = Ledger.normalize({
				cash = 0 / 0,
				positions = {
					APX = { shares = 5, avgCost = 100 },
					ZZZ = { shares = 5, avgCost = 10 },
					NMB = { shares = 1.5, avgCost = 10 },
					MRB = { shares = 3, avgCost = -1 },
				},
				stops = { NMB = { stop = 1 }, APX = { stop = 80 } },
			})
			t.expect(b.positions.APX.shares).toBe(5)
			t.expect(b.positions.ZZZ).toBeNil()
			t.expect(b.positions.NMB).toBeNil()
			t.expect(b.positions.MRB).toBeNil()
			t.expect(b.stops.NMB).toBeNil()
			t.expect(b.stops.APX.stop).toBe(80)
			t.expect(b.cash).toBe(Ledger.STUDENT_BOOK)
			t.expect(b.credits.capital).toBe(0)
			t.expect(type(b.limits)).toBe("table")
		end)
		t.it("summarises the book for the account bar", function()
			local b = book(10000)
			b.sessionStart = 10000
			Ledger.fill(b, "APX", 10, 100, 1, "trade")
			local s = Ledger.summary(b, { APX = 110 })
			t.expect(s.invested).toBe(1100)
			t.expect(s.unrealized).toBeCloseTo(10 * (110 - 100.025), 1e-2)
			t.expect(s.sessionPnl).toBeCloseTo(s.equity - 10000, 1e-6)
			t.expect(s.drawdown).toBe(0)
		end)
	end)
end
