-- Assignment (Logic/Economy/Assign): which context each career state wants, pool claims and releases, preferred
-- indices, capacity exhaustion, the office-to-desk fallback and floors rebuilt with fewer slots.

local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Logic.Economy)
local World = require(Shared.Config.World)
local Assign = Economy.Assign

return function(t)
	t.describe("contextsFor", function()
		t.it("students live in the dorm and have no desk", function()
			local w = Assign.contextsFor({ student = true, employed = false, rank = 0 })
			t.expect(w.unit).toBe("dorm")
			t.expect(w.work).toBeNil()
		end)
		t.it("employees get an apartment and a desk on their floor", function()
			local w = Assign.contextsFor({ employed = true, rank = 1, companyId = "mg_freeman", track = "ib" })
			t.expect(w.unit).toBe("apartment")
			t.expect(w.work).toBe("desk")
			t.expect(w.companyId).toBe("mg_freeman")
			t.expect(w.track).toBe("ib")
			t.expect(Assign.contextsFor({ employed = true, rank = 2, companyId = "x", track = "ib" }).work).toBe("desk")
		end)
		t.it("rank 3 and above want a private office", function()
			t.expect(
				Assign.contextsFor({ employed = true, rank = Assign.OFFICE_RANK, companyId = "x", track = "ib" }).work
			)
				.toBe("office")
			t.expect(Assign.contextsFor({ employed = true, rank = 5, companyId = "x", track = "ib" }).work)
				.toBe("office")
		end)
		t.it("the role's own office flag wins over the rank rule", function()
			t.expect(
				Assign.contextsFor({ employed = true, rank = 2, companyId = "x", track = "ib", office = true }).work
			)
				.toBe("office")
			t.expect(
				Assign.contextsFor({ employed = true, rank = 4, companyId = "x", track = "ib", office = false }).work
			)
				.toBe("desk")
		end)
		t.it("an employee without a known floor still gets an apartment", function()
			local w = Assign.contextsFor({ employed = true, rank = 2 })
			t.expect(w.unit).toBe("apartment")
			t.expect(w.work).toBeNil()
		end)
		t.it("a fired player holds no room (their decor stays saved)", function()
			local w = Assign.contextsFor({ student = false, employed = false, rank = 2 })
			t.expect(w.unit).toBeNil()
			t.expect(w.work).toBeNil()
		end)
	end)

	t.describe("pools", function()
		t.it("claims the lowest free index and is idempotent per owner", function()
			local pool = Assign.newPool(3)
			t.expect(Assign.claim(pool, "a")).toBe(1)
			t.expect(Assign.claim(pool, "b")).toBe(2)
			t.expect(Assign.claim(pool, "a")).toBe(1)
			t.expect(Assign.ownerOf(pool, 2)).toBe("b")
			t.expect(Assign.indexOf(pool, "b")).toBe(2)
			t.expect(Assign.freeCount(pool)).toBe(1)
		end)
		t.it("prefers the owner's previous index while it is free", function()
			local pool = Assign.newPool(5)
			t.expect(Assign.claim(pool, "a", 4)).toBe(4)
			t.expect(Assign.claim(pool, "b", 4)).toBe(1) -- taken: lowest free instead
			t.expect(Assign.claim(pool, "c", 99)).toBe(2) -- out of range: ignored
		end)
		t.it("returns nil when the pool is exhausted, and frees on release", function()
			local pool = Assign.newPool(World.floorSlots.offices)
			for i = 1, World.floorSlots.offices do
				t.expect(Assign.claim(pool, "p" .. i)).toBe(i)
			end
			t.expect(Assign.claim(pool, "late")).toBeNil()
			t.expect(Assign.freeCount(pool)).toBe(0)
			t.expect(Assign.release(pool, "p3")).toBe(3)
			t.expect(Assign.claim(pool, "late")).toBe(3)
			t.expect(Assign.release(pool, "nobody")).toBeNil()
		end)
		t.it("an empty pool never assigns", function()
			t.expect(Assign.claim(Assign.newPool(0), "a")).toBeNil()
			t.expect(Assign.claim(Assign.newPool(0 / 0), "a")).toBeNil()
			t.expect(Assign.claim(Assign.newPool(2), nil)).toBeNil()
		end)
		t.it("resize evicts owners above the new capacity", function()
			local pool = Assign.newPool(4)
			for _, o in { "a", "b", "c", "d" } do
				Assign.claim(pool, o)
			end
			local evicted = Assign.resize(pool, 2)
			table.sort(evicted)
			t.expect(evicted).toEqual({ "c", "d" })
			t.expect(Assign.indexOf(pool, "c")).toBeNil()
			t.expect(Assign.indexOf(pool, "a")).toBe(1)
		end)
		t.it("a full server of players always fits the 24 dorm rooms or desks", function()
			local pool = Assign.newPool(World.floorSlots.desks)
			for i = 1, World.MAX_PLAYERS do
				t.expect(Assign.claim(pool, i)).toBeTruthy()
			end
		end)
	end)

	t.describe("work", function()
		t.it("gives seniors an office and juniors a desk", function()
			local desks, offices = Assign.newPool(24), Assign.newPool(8)
			t.expect((Assign.work(desks, offices, "vp", true))).toBe("office")
			t.expect((Assign.work(desks, offices, "analyst", false))).toBe("desk")
			t.expect(Assign.indexOf(offices, "vp")).toBe(1)
			t.expect(Assign.indexOf(desks, "analyst")).toBe(1)
		end)
		t.it("falls back to a desk when every office is taken", function()
			local desks, offices = Assign.newPool(24), Assign.newPool(1)
			Assign.work(desks, offices, "md", true)
			local kind, index, note = Assign.work(desks, offices, "vp", true)
			t.expect(kind).toBe("desk")
			t.expect(index).toBe(1)
			t.expect(note).toBe("office_full")
		end)
		t.it("reports a full floor", function()
			local desks, offices = Assign.newPool(1), Assign.newPool(0)
			Assign.work(desks, offices, "a", false)
			local kind, index, note = Assign.work(desks, offices, "b", false)
			t.expect(kind).toBeNil()
			t.expect(index).toBeNil()
			t.expect(note).toBe("desk_full")
		end)
		t.it("a promotion moves the desk into an office and frees the desk", function()
			local desks, offices = Assign.newPool(24), Assign.newPool(8)
			Assign.work(desks, offices, "p", false, { desk = 7 })
			t.expect(Assign.indexOf(desks, "p")).toBe(7)
			t.expect((Assign.work(desks, offices, "p", true, { office = 2 }))).toBe("office")
			t.expect(Assign.indexOf(desks, "p")).toBeNil()
			t.expect(Assign.indexOf(offices, "p")).toBe(2)
			-- a demotion (re-entry one rank lower) goes back to a desk and frees the office
			t.expect((Assign.work(desks, offices, "p", false, { desk = 7 }))).toBe("desk")
			t.expect(Assign.indexOf(offices, "p")).toBeNil()
			t.expect(Assign.indexOf(desks, "p")).toBe(7)
		end)
	end)

	t.it("floor keys are stable", function()
		t.expect(Assign.floorKey("mg_freeman", "ib")).toBe("mg_freeman|ib")
	end)
end
