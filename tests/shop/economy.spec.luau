-- Economy maths (Logic/Economy/Wallet): multipliers per income kind, clamps, credits, all-or-nothing spends and
-- living charges that never push cash below zero.

local Shared = game:GetService("ReplicatedStorage").Shared
local Economy = require(Shared.Logic.Economy)
local Shop = require(Shared.Config.Shop)
local Wallet = Economy.Wallet

local E = Shop.economy

return function(t)
	t.describe("Wallet.normalize", function()
		t.it("builds a fresh wallet from nothing", function()
			local w = Wallet.normalize(nil)
			t.expect(w.cash).toBe(0)
			t.expect(w.earned).toBe(0)
			t.expect(w.spent).toBe(0)
			t.expect(w.living).toBe(0)
			t.expect(#w.recent).toBe(0)
		end)
		t.it("repairs bad numbers, rounds to whole dollars and trims the ring", function()
			local raw = { cash = 12.6, earned = -5, spent = 0 / 0, living = math.huge, recent = {} }
			for i = 1, E.recent + 5 do
				table.insert(raw.recent, { at = i, delta = i, source = "x" })
			end
			table.insert(raw.recent, { at = "bad", delta = 1 })
			local w = Wallet.normalize(raw)
			t.expect(w).toBe(raw) -- repaired in place
			t.expect(w.cash).toBe(13)
			t.expect(w.earned).toBe(0)
			t.expect(w.spent).toBe(0)
			t.expect(w.living).toBe(0)
			t.expect(#w.recent).toBe(E.recent)
			t.expect(w.recent[#w.recent].delta).toBe(E.recent + 5)
		end)
	end)

	t.describe("multipliers", function()
		local mults = { event = 2, daily = 2, income = 1.5 }
		t.it("salary and bonus get the event, daily and rebirth income multipliers", function()
			t.expect(Wallet.multiplier("salary", mults)).toBeCloseTo(6)
			t.expect(Wallet.multiplier("bonus", mults)).toBeCloseTo(6)
		end)
		t.it("reward gets the income multiplier only", function()
			t.expect(Wallet.multiplier("reward", mults)).toBeCloseTo(1.5)
		end)
		t.it("refund and admin are credited exactly", function()
			t.expect(Wallet.multiplier("refund", mults)).toBe(1)
			t.expect(Wallet.multiplier("admin", mults)).toBe(1)
		end)
		t.it("unknown kinds fall back to the default kind", function()
			local id = Wallet.kindOf("lottery")
			t.expect(id).toBe(E.defaultKind)
			t.expect(Wallet.multiplier(nil, mults)).toBeCloseTo(Wallet.multiplier(E.defaultKind, mults))
		end)
		t.it("clamps broken multipliers instead of printing money", function()
			t.expect(Wallet.multiplier("salary", { event = 1000, daily = 1000, income = 1000 }))
				.toBeCloseTo(E.eventMult[2] * E.dailyMult[2] * E.incomeMult[2])
			t.expect(Wallet.multiplier("salary", { event = 0 / 0, daily = -3, income = math.huge })).toBe(1)
			-- a daily boost below 1 never reduces pay; the rebirth multiplier is at least 1
			t.expect(Wallet.multiplier("salary", { daily = 0.5, income = 0.2 })).toBe(1)
		end)
		t.it("an event may lower salary (but not below zero)", function()
			t.expect(Wallet.multiplier("salary", { event = 0.5 })).toBeCloseTo(0.5)
		end)
	end)

	t.describe("creditAmount", function()
		t.it("multiplies and rounds", function()
			t.expect(Wallet.creditAmount(1000, "salary", { event = 1.5, daily = 2, income = 1.1 })).toBe(3300)
			t.expect(Wallet.creditAmount(99.5, "reward", {})).toBe(100)
		end)
		t.it("rejects invalid amounts", function()
			t.expect(Wallet.creditAmount(-5, "salary", {})).toBe(0)
			t.expect(Wallet.creditAmount(0, "salary", {})).toBe(0)
			t.expect(Wallet.creditAmount(0 / 0, "salary", {})).toBe(0)
			t.expect(Wallet.creditAmount("100", "salary", {})).toBe(0)
		end)
		t.it("caps a single credit", function()
			t.expect(Wallet.creditAmount(E.maxCredit * 10, "admin", {})).toBe(E.maxCredit)
		end)
	end)

	t.describe("credit, spend, charge", function()
		t.it("credit adds to cash and earned and logs it", function()
			local w = Wallet.normalize({})
			t.expect(Wallet.credit(w, 250, "work", 100)).toBe(250)
			t.expect(w.cash).toBe(250)
			t.expect(w.earned).toBe(250)
			t.expect(w.recent[1].delta).toBe(250)
			t.expect(w.recent[1].source).toBe("work")
			t.expect(w.recent[1].at).toBe(100)
			t.expect(Wallet.credit(w, -10, "bad", 101)).toBe(0)
			t.expect(w.cash).toBe(250)
		end)
		t.it("spend is all or nothing and never goes negative", function()
			local w = Wallet.normalize({ cash = 500 })
			t.expect(Wallet.spend(w, 501, "shop", 1)).toBe(false)
			t.expect(w.cash).toBe(500)
			t.expect(Wallet.spend(w, 500, "shop", 1)).toBe(true)
			t.expect(w.cash).toBe(0)
			t.expect(w.spent).toBe(500)
			t.expect(Wallet.spend(w, 1, "shop", 1)).toBe(false)
		end)
		t.it("spend refuses negative, NaN and oversized amounts; zero is free", function()
			local w = Wallet.normalize({ cash = 100 })
			t.expect(Wallet.spend(w, -50, "x", 1)).toBe(false)
			t.expect(Wallet.spend(w, 0 / 0, "x", 1)).toBe(false)
			t.expect(Wallet.spend(w, E.maxSpend + 1, "x", 1)).toBe(false)
			t.expect(Wallet.spend(w, 0, "x", 1)).toBe(true)
			t.expect(w.cash).toBe(100)
			t.expect(#w.recent).toBe(0)
		end)
		t.it("living costs take what's there and stop at zero", function()
			local w = Wallet.normalize({ cash = 120 })
			t.expect(Wallet.charge(w, 50, "living", 1)).toBe(50)
			t.expect(w.cash).toBe(70)
			t.expect(Wallet.charge(w, 400, "living", 2)).toBe(70)
			t.expect(w.cash).toBe(0)
			t.expect(w.living).toBe(120)
			t.expect(Wallet.charge(w, 10, "living", 3)).toBe(0)
			t.expect(Wallet.charge(w, -10, "living", 3)).toBe(0)
		end)
		t.it("living charges are capped per call", function()
			local w = Wallet.normalize({ cash = E.maxLiving * 3 })
			t.expect(Wallet.charge(w, E.maxLiving * 2, "living", 1)).toBe(E.maxLiving)
		end)
	end)
end
